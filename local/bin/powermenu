#!/bin/bash

OPTIONS="⏻ Shutdown
⏾ Reboot
󰒲 Suspend
󰍃 Logout
󰷛 Lock"

CHOICE=$(printf '%s\n' "$OPTIONS" | fuzzel \
    --dmenu \
    --prompt="Power Menu: " \
    --width=20)

case "$CHOICE" in
    *"Shutdown")
        systemctl poweroff
        ;;
    *"Reboot")
        systemctl reboot
        ;;
    *"Suspend")
        systemctl suspend
        ;;
    *"Logout")
        niri msg action quit
        ;;
    *"Lock")
        niri-lock
        ;;
esac
