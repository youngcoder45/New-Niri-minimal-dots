// Niri Basic Settings - Layout, Animations, Input
// Single source of truth for these settings.

prefer-no-csd

// ── Overview ──────────────────────────────────────────────────
overview {
    zoom 0.5
    backdrop-color "#1e1e2e"
}

// ── Animations ────────────────────────────────────────────────
animations {
    on
    slowdown 1.0
}

// ── Layout ────────────────────────────────────────────────────
layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.5 }

    shadow { off }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    focus-ring {
        off
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    insert-hint {
        color "#ffc87f70"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        corner-radius 4
        width 4
        length total-proportion=1.0
        gap 4
        gaps-between-tabs 2
    }
}

// ── Window Defaults ───────────────────────────────────────────
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
}

// ── Input ─────────────────────────────────────────────────────
input {
    focus-follows-mouse
    mod-key "Super"

    touchpad {
        tap
        natural-scroll
        drag false
        click-method "clickfinger"
        scroll-method "two-finger"
        accel-speed 0.20
        accel-profile "adaptive"
        tap-button-map "left-right-middle"
        scroll-factor 1.0
    }

    mouse {
        accel-speed 0.20
        accel-profile "adaptive"
        scroll-factor 1.0
    }

    keyboard {
        track-layout "window"
        numlock
        repeat-delay 600
        repeat-rate 25
    }
}

// ── Hotkey Overlay ────────────────────────────────────────────
hotkey-overlay {
    hide-not-bound
    skip-at-startup
}

// ── Gestures ──────────────────────────────────────────────────
gestures {
    hot-corners { }
}

// ── Cursor ────────────────────────────────────────────────────
cursor { }
