// Niri Configuration
// https://yalter.github.io/niri/Configuration:-Introduction

// Monitor configuration (uncomment and adjust for your display)
/-output "eDP-1" {
    mode "1366x768@59.790"
    scale 2
    transform "normal"
    position x=1280 y=0
}

// Environment variables
environment {
    XCURSOR_THEME "Bibata-Modern-Classic"
    XCURSOR_SIZE "24"
}

// Startup applications
spawn-at-startup "~/.config/niri/autostart.sh"
spawn-at-startup "nm-applet"
spawn-at-startup "gnome-keyring-daemon --start --components=pkcs11,secrets,ssh"

// Hotkey overlay
hotkey-overlay {
    skip-at-startup
}

// Prefer server-side decorations when possible
prefer-no-csd

// Screenshot save path
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ── Window Rules ──────────────────────────────────────────────

// Alacritty - slightly transparent
window-rule {
    match app-id="Alacritty"
    opacity 0.87
}

// Nautilus - file manager
window-rule {
    match app-id="nautilus"
    opacity 0.93
}

// Brave browser - maximized
window-rule {
    match app-id="brave-browser"
    opacity 0.93
    open-maximized true
}

// Vesktop / Discord - maximized
window-rule {
    match app-id="vesktop"
    opacity 0.93
    open-maximized true
}

window-rule {
    match app-id="discord"
    opacity 0.93
    open-maximized true
}

// VS Code - maximized
window-rule {
    match app-id=r#"^Code$|^code$"#
    opacity 0.93
    open-maximized true
}

// Firefox picture-in-picture - floating
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Rounded corners for all windows
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// ── Includes ──────────────────────────────────────────────────
include "basicsettings.kdl"
include "keybinds.kdl"
